# Loss functions
# Absolute Loss
L <- function(x) abs(x)

# Huber Loss
huber_loss <- function(x, w = 0.01) {
  loss <- ifelse(abs(x) <= w, 0.5 * x^2, w * (abs(x) - 0.5 * w))
  return(loss)
}

# Logcosh Loss
Logc_loss <- function(x) abs(x) + log1p(exp(-2*abs(x))) - log(2)

# Tukey bisquare loss function 
tukey_loss <- function(r, c =3.5) {
  u <- r / c
  out <- ifelse(abs(u) <= 1,
                (c^2 / 6) * (1 - (1 - u^2)^3),
                c^2 / 6)
  return(out)
}

# CLAD estimator (Censored LAD)
set.seed(123)
f_1 <- function(beta, rho, n) {
  
  ## Instruments and regressors
  z   <- runif(n)
  e_1 <- rnorm(n)
  x_1 <- rnorm(n)
  
  ## Endogenous regressor
  x_2 <- beta[1] + beta[2]*x_1 + beta[3]*z + e_1
  
  # =========================
  #  Stage 1: LSE
  # =========================
  res <- residuals(lm(x_2 ~ z + x_1))
  
  ## Structural error
  
  ## Standard Normal
  #error <- rnorm(n)
  
  ## laplace distribution
  #error <-  rLaplace(n, m = 0, s = 1/sqrt(2))
  
  ## Student t Distribution
  #error <- rt(n,3)
  
  # Heteroskedastic error where variance depends on x1 and x2
  sigma2 <- 0.4^2 * (1 + x_1^2 + x_2^2)
  
  # Heteroskedastic structural error
  error <- rnorm(n, 0, sqrt(sigma2))
  e <- rho * (e_1 - res) + error
  
  
  ## Latent variable
  y_star <- beta[1] + beta[2]*x_1 + beta[3]*x_2 + rho*res + e
  
  ## Censored outcome
  y <- pmax(0, y_star)
  
  censoring <- mean(y_star < 0) * 100
  
  data <- data.frame(y, x_1, x_2, res)
  
  # =========================
  # Tobit MLE FOR INITIAL VALUE
  # =========================
  mle_fit <- tobit(y ~ x_1 + x_2 + res, left = 0, data = data)
  mle_par <- coef(mle_fit)
  
  # =========================
  # Stage 2: CLAD (LAD Tobit)
  # =========================
  
  f1 <- function(theta) {
    mu_hat <- theta[1] + theta[2]*x_1 + theta[3]*x_2 + theta[4]*res
    mean(L(y - pmax(0, mu_hat)))
  }
  
  # Use MLE as initial values
  init <- mle_par
  
  clad_fit <- optim(init, f1, method = "Nelder-Mead")
  
  c(clad_fit$par, censoring)
}


### Huber loss optimization (WME)
set.seed(123)
f_1_huber <- function(beta, rho, n) {
  
  ## Instruments and regressors
  z   <- runif(n)
  e_1 <- rnorm(n)
  x_1 <- rnorm(n)
  
  ## Endogenous regressor
  x_2 <- beta[1] + beta[2]*x_1 + beta[3]*z + e_1
  
  # =========================
  # Stage 1: LSE
  # =========================
  res <- residuals(lm(x_2 ~ z + x_1))
  
  ## Structural error
  
  ## Standard Normal
  #error <- rnorm(n)
  
  # laplace distribution
  #error <-  rLaplace(n, m = 0, s = 1/sqrt(2))
  
  ## Student t Distribution
    #error <- rt(n,3)
  
  # Heteroskedastic error where variance depends on x1 and x2
  sigma2 <- 0.4^2 * (1 + x_1^2 + x_2^2)
  
  # Heteroskedastic structural error
  error <- rnorm(n, 0, sqrt(sigma2))
  e <- rho * (e_1 - res) + error
  
  ## Latent variable
  y_star <- beta[1] + beta[2]*x_1 + beta[3]*x_2 + rho*res + e
  
  ## Censored outcome
  y <- pmax(0, y_star)
  
  censoring <- mean(y_star < 0) * 100
  
  data <- data.frame(y, x_1, x_2, res)
  
  # =========================
  # Tobit MLE FOR INITIAL VALUE
  # =========================
  mle_fit <- tobit(y ~ x_1 + x_2 + res, left = 0, data = data)
  mle_par <- coef(mle_fit)
  
  # =========================
  # Stage 2: Huber Tobit (CF)
  # =========================
  
  f2 <- function(theta) {
    mu_hat <- theta[1] + theta[2]*x_1 + theta[3]*x_2 + theta[4]*res
    r <- y - pmax(0, mu_hat)
    mean(huber_loss(r))
  }
  
  # Use MLE as initial values
  init <- as.numeric(mle_par)
  
  huber_fit <- optim(init, f2, method = "Nelder-Mead")
  
  c(huber_fit$par, censoring)
}

